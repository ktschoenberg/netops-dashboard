{
  "rewrites": [
    { "source": "/", "destination": "/claire-app/index.html" }
  ],
  "functions": {
    "api/proxy.js": {
      "runtime": "edge"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
